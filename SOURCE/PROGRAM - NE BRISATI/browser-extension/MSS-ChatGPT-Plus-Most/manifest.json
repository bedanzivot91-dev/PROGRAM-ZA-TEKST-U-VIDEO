{
  "manifest_version": 3,
  "name": "Muzički Spot Studio — ChatGPT Plus Most",
  "version": "15.6.0",
  "key": "",
  "description": "Lokalni most za privatni GPT: YouTube reference, prompt → priča → storyboard, image i video promptovi, standardni Korak 3.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "clipboardWrite",
    "scripting",
    "notifications"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "local-app.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "chatgpt-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Muzički Spot Studio — ChatGPT Plus Most",
    "default_popup": "popup.html"
  }
}
